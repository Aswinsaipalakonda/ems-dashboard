# Ignore SQL dump files
*.sql
!database/*.sql

# Environment files
.env
.env.*

# Composer / Node dependencies
/vendor/
/node_modules/

# Uploaded content (user files)
/uploads/

# Logs, OS, and editor files
*.log
.DS_Store
.idea/
.vscode/

# Ignore build artifacts
/dist/
/build/
.playwright-mcp/
assets/references/
scratch/
__pycache__/
*.pyc
